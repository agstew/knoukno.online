# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/knoukno

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - frontend origin(s), comma separated
CLIENT_ORIGIN=http://localhost:5173

# Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=KnoUKno <hello@knoukno.online>

# PayPal (https://developer.paypal.com)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# Billing Plan IDs - created once via `node scripts/setupPaypalPlans.js`
PAYPAL_MEMBER_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
